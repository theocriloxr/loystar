# Copy this file to .env for local development.
# The values below are safe local defaults, not production defaults.

# Runtime
ENVIRONMENT=development
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_SERVER_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_REQUEST_BODY_BYTES=1048576
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development-only surfaces. Production startup rejects true values.
ENABLE_DEMO_ROUTES=true
ENABLE_LEGACY_ROUTES=true
ENABLE_PROTOTYPE_ROUTES=true
ENABLE_PROTOTYPE_TOOLS=true
ENABLE_BILLING_ROUTES=true

# Required in production
# DATABASE_URL=postgresql+asyncpg://loystar:replace-me@localhost:5432/loystar
# REDIS_URL=redis://localhost:6379/0
# OAUTH_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# ADMIN_API_KEY=replace-with-at-least-32-random-characters

# Loystar API
LOYSTAR_API_BASE_URL=https://api.loystar.co
LOYSTAR_API_V1_BASE_URL=https://api1.loystar.co
LOYSTAR_TIMEOUT_SECONDS=20
LOYSTAR_REDACT_PII=true
ALLOW_REQUEST_PII_OVERRIDE=false
ALLOW_ENVIRONMENT_CREDENTIALS=true

# Optional single-merchant local credentials.
# These are forbidden when ENVIRONMENT=production.
# LOYSTAR_ACCESS_TOKEN=
# LOYSTAR_TOKEN_TYPE=Bearer
# LOYSTAR_CLIENT=
# LOYSTAR_UID=
# LOYSTAR_EXPIRY=

# OAuth 2.1
# OAUTH_ISSUER defaults to MCP_SERVER_BASE_URL when empty.
OAUTH_ISSUER=
OAUTH_CODE_TTL_SECONDS=300
OAUTH_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_ALLOW_DYNAMIC_REGISTRATION=true
# Leave empty for standards-compatible public dynamic client registration.
# OAUTH_DCR_INITIAL_ACCESS_TOKEN=
OAUTH_STATIC_CLIENTS_JSON=[]

# Optional extra gateway authentication.
# Keep false for normal OAuth-based ChatGPT/Claude/Perplexity connections.
REQUIRE_CONNECTOR_AUTH=false
# CONNECTOR_API_KEY=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
OAUTH_RATE_LIMIT_REQUESTS=20
AUDIT_LOG_MAX_EVENTS=500

# Billing and prototype integrations are disabled in production.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_FREE=
# STRIPE_PRICE_ID_PRO=
# STRIPE_PRICE_ID_ENTERPRISE=
# PAYSTACK_SECRET_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SENDGRID_API_KEY=

# Reserved legacy/prototype settings; not used by the production OAuth bridge.
JWT_SECRET_KEY=change_this_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
# AI_PROVIDER=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# PINECONE_API_KEY=
