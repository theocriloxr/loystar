# Replace every placeholder through your deployment platform's secret manager.
ENVIRONMENT=production
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_SERVER_BASE_URL=https://loystar-production.up.railway.app
OAUTH_ISSUER=https://loystar-production.up.railway.app
ALLOWED_HOSTS=loystar-production.up.railway.app,healthcheck.railway.app
ALLOWED_ORIGINS=https://your-admin.example.com
TRUST_PROXY_HEADERS=true
MAX_REQUEST_BODY_BYTES=1048576

DATABASE_URL=postgresql+asyncpg://user:password@postgres.example.com:5432/loystar_mcp
REDIS_URL=rediss://default:password@redis.example.com:6379/0
OAUTH_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

LOYSTAR_API_BASE_URL=https://api.loystar.co
LOYSTAR_API_V1_BASE_URL=https://api1.loystar.co
LOYSTAR_TIMEOUT_SECONDS=20
LOYSTAR_REDACT_PII=true
ALLOW_REQUEST_PII_OVERRIDE=false
ALLOW_ENVIRONMENT_CREDENTIALS=false

OAUTH_CODE_TTL_SECONDS=300
OAUTH_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_ALLOW_DYNAMIC_REGISTRATION=true
OAUTH_ENABLE_CIMD=true
OAUTH_STATIC_CLIENTS_JSON=[]

REQUIRE_CONNECTOR_AUTH=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
OAUTH_RATE_LIMIT_REQUESTS=20
AUDIT_LOG_MAX_EVENTS=500

ENABLE_DEMO_ROUTES=false
ENABLE_LEGACY_ROUTES=false
ENABLE_PROTOTYPE_ROUTES=false
ENABLE_PROTOTYPE_TOOLS=false
ENABLE_BILLING_ROUTES=false
